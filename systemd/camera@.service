[Unit]
Description=Camera Recorder %i
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Restart=always
RestartSec=10
TimeoutStopSec=5
KillMode=control-group
LimitNOFILE=65536

# Konfiguracja kamery (RTSP_URL, SEGMENT_TIME, PRE_CROP)
EnvironmentFile=/home/ubuntu/projects/mcrwac/config/camera_%i.env

# Przekazanie nazwy kamery do skryptu
Environment=CAMERA=%i

# Główna logika w skrypcie
ExecStart=/home/ubuntu/projects/mcrwac/scripts/record_camera.sh

[Install]
WantedBy=multi-user.target
