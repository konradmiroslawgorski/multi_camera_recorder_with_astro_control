[Unit]
Description=Analiza ruchu sikorek (POE1), kazde zakonczone nagranie
After=local-fs.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/mcrwac
ExecStart=/home/ubuntu/projects/mcrwac/venv_motion/bin/python -u -m mcrwac.analysis.poe1_bird_motion --watch
Restart=always
RestartSec=30
TimeoutStopSec=30
# Rejestrator ma pierwszenstwo przed analiza (CPU i dysk).
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
